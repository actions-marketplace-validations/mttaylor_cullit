{
  "name": "cullit",
  "version": "3.4.0",
  "type": "module",
  "description": "Cullit CLI for local and integrated release note generation.",
  "license": "MIT",
  "author": "Cullit <dev@cullit.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mttaylor/cullit",
    "directory": "packages/cli"
  },
  "keywords": [
    "release-notes",
    "changelog",
    "ai",
    "cli",
    "devops",
    "automation"
  ],
  "homepage": "https://cullit.io",
  "bugs": {
    "url": "https://github.com/mttaylor/cullit/issues"
  },
  "bin": {
    "cullit": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch"
  },
  "dependencies": {
    "@cullit/core": "workspace:*",
    "@cullit/config": "workspace:*"
  }
}
