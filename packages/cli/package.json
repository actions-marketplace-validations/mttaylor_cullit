{
  "name": "cullit",
  "version": "1.8.1",
  "type": "module",
  "description": "Cull the noise from your releases. AI-powered release notes from the CLI.",
  "license": "MIT",
  "author": "Cullit <matt@cullit.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mttaylor/cullit",
    "directory": "packages/cli"
  },
  "keywords": ["release-notes", "changelog", "ai", "cli", "devops", "automation"],
  "bin": {
    "cullit": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch"
  },
  "dependencies": {
    "@cullit/core": "workspace:*",
    "@cullit/config": "workspace:*"
  }
}
