{
  "name": "@cullit/app",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "description": "Cullit GitHub App — auto-generate release notes on tag push or release publish.",
  "license": "MIT",
  "author": "Cullit <matt@cullit.io>",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch --onSuccess 'node dist/index.js'",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@cullit/core": "workspace:*"
  },
  "peerDependencies": {
    "@cullit/pro": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@cullit/pro": {
      "optional": true
    }
  },
  "devDependencies": {}
}
