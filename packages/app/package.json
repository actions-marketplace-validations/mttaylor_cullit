{
  "name": "@cullit/app",
  "version": "2.9.0",
  "private": true,
  "type": "module",
  "description": "Cullit GitHub App — auto-generate release notes on tag push or release publish.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Cullit <matt@cullit.io>",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch --onSuccess 'node dist/index.js'",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@cullit/core": "workspace:*",
    "pino": "^10.3.1"
  },
  "peerDependencies": {
    "@cullit/pro": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@cullit/pro": {
      "optional": true
    }
  }
}
