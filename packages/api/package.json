{
  "name": "@cullit/api",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Cullit REST API server for AI-powered release note generation.",
  "license": "MIT",
  "author": "Cullit <matt@cullit.io>",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts src/openapi.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch --onSuccess 'node dist/index.js'",
    "test": "vitest run"
  },
  "dependencies": {
    "@cullit/core": "workspace:*",
    "@cullit/config": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
