{
  "name": "@cullit/config",
  "version": "2.10.0",
  "type": "module",
  "description": "Config loader for Cullit — YAML config parsing with env var resolution.",
  "license": "MIT",
  "author": "Cullit <matt@cullit.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mttaylor/cullit",
    "directory": "packages/config"
  },
  "homepage": "https://cullit.io",
  "bugs": {
    "url": "https://github.com/mttaylor/cullit/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cullit",
    "config",
    "yaml",
    "release-notes",
    "changelog"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run"
  }
}
