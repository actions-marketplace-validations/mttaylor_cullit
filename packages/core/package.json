{
  "name": "@cullit/core",
  "version": "2.10.0",
  "type": "module",
  "description": "Core engine for Cullit — AI-powered release note generation.",
  "license": "MIT",
  "author": "Cullit <matt@cullit.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mttaylor/cullit",
    "directory": "packages/core"
  },
  "keywords": [
    "release-notes",
    "changelog",
    "ai",
    "automation"
  ],
  "homepage": "https://cullit.io",
  "bugs": {
    "url": "https://github.com/mttaylor/cullit/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@cullit/config": "workspace:*"
  }
}
