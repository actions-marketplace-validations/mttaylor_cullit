{
  "name": "@cull/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core engine for Cullit — AI-powered release note generation.",
  "license": "MIT",
  "author": "Deploy or Die <matt@deployordie.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/deployordie/cullit",
    "directory": "packages/core"
  },
  "keywords": ["release-notes", "changelog", "ai", "automation"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "dependencies": {
    "@cull/config": "workspace:*"
  }
}
