{
  "name": "cullit",
  "version": "2.6.0",
  "private": true,
  "description": "Cull the noise from your releases. AI-powered release notes.",
  "author": "Cullit <matt@cullit.io>",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mttaylor/cullit"
  },
  "keywords": [
    "release-notes",
    "changelog",
    "ai",
    "github-action",
    "automation",
    "devops"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build && pnpm build:action",
    "build:action": "tsup src/action.ts --format cjs --out-dir dist --no-splitting --target node22",
    "build:widget": "esbuild site/widget.ts --bundle --minify --format=iife --outfile=site/widget.js --target=es2020",
    "hooks:install": "git config core.hooksPath .githooks",
    "lockfile:check": "pnpm install --frozen-lockfile",
    "lockfile:sync": "pnpm install --no-frozen-lockfile",
    "launch:ready": "pnpm lockfile:check && pnpm build && pnpm lint && pnpm test && pnpm test:e2e && pnpm validate:guards",
    "validate:guards": "node scripts/validate-guards.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev": "pnpm --filter @cullit/cli dev",
    "dev:api": "pnpm --filter @cullit/api dev",
    "start:api": "node --env-file=.env packages/api/dist/index.js",
    "dev:site": "node scripts/serve-site.mjs",
    "lint": "eslint packages/ --max-warnings=250",
    "cullit": "node packages/cli/dist/index.js"
  },
  "dependencies": {
    "@cullit/config": "workspace:*",
    "@cullit/core": "workspace:*",
    "@cullit/pro": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
