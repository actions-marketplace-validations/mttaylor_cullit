# =====================================================
# Cullit Environment Variables
# Copy this file to .env and fill in your values.
#
# Two usage modes:
#   1. CLI only  — just set AI keys + any integrations you use
#   2. API server / self-hosted — fill in the Server section too
# =====================================================

# ===================
# CLI — AI Providers
# Set at least one.
# ===================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# ===================
# CLI — Integrations (optional, set what you use)
# ===================
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=

# LINEAR_API_KEY=

# GITLAB_TOKEN=
# GITLAB_PROJECT_ID=

# BITBUCKET_USERNAME=
# BITBUCKET_APP_PASSWORD=

# ===================
# CLI — Publishing (optional, set what you use)
# ===================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# GITHUB_TOKEN=
# CONFLUENCE_EMAIL=you@company.com
# CONFLUENCE_API_TOKEN=
# NOTION_API_KEY=

# ===================
# API Server — Core
# Required when running the API server.
# ===================
PORT=3000
CULLIT_BASE_URL=https://api.cullit.io
CULLIT_DASHBOARD_URL=https://cullit.io/dashboard.html
ALLOWED_ORIGINS=https://cullit.io   # Comma-separated; use * for local dev only

# JWT signing secret — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CULLIT_JWT_SECRET=

# Cullit license key (grants Pro features to the API server itself)
CULLIT_API_KEY=

# ===================
# API Server — Database
# Strongly recommended in production. Without this, data is lost on restart.
# ===================
DATABASE_URL=   # PostgreSQL connection string
#
# Backup strategy:
#   Railway:     Automatic daily snapshots on Pro plan.
#                Manual: railway connect postgres → pg_dump > backup.sql
#   Self-hosted: 0 2 * * * pg_dump $DATABASE_URL | gzip > /backups/cullit-$(date +\%F).sql.gz

# ===================
# API Server — WorkOS AuthKit (dashboard login)
# Configure at: https://dashboard.workos.com
#   Redirect URI: https://api.cullit.io/auth/callback
# ===================
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# ===================
# API Server — Stripe (paid tiers)
# Get keys from: https://dashboard.stripe.com/apikeys
# Get price IDs from: https://dashboard.stripe.com/products
# ===================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=    # Price ID for Pro plan ($9/mo)
STRIPE_TEAM_PRICE_ID=   # Price ID for Team plan ($19/seat/mo)

# ===================
# API Server — Email (Resend)
# Required for welcome, trial expiry, and payment emails.
# ===================
# RESEND_API_KEY=
# EMAIL_FROM=Cullit <noreply@cullit.io>

# ===================
# API Server — GitHub App (optional, for Marketplace listing)
# ===================
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=   # base64-encoded PEM
# GITHUB_WEBHOOK_SECRET=
# CULLIT_APP_PORT=3001

# ===================
# API Server — Observability (optional)
# ===================
# METRICS_TOKEN=    # Bearer token to gate GET /metrics
# LOG_LEVEL=info    # trace | debug | info | warn | error | fatal

# ===================
# API Server — Tuning (optional, defaults shown)
# ===================
# RATE_LIMIT=30         # Requests per minute per IP
# CACHE_TTL=300000      # Pipeline cache TTL in ms (5 min)
# MAX_CACHE_SIZE=100    # Max cached pipeline results
# CULLIT_TRIAL_DAYS=14  # Free trial length in days
# NODE_ENV=production   # Enables production safety checks
