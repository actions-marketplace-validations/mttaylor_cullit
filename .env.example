# =====================================================
# Cullit Environment Variables
# Copy this file to .env and fill in your values.
# =====================================================

# --- Cullit License (Pro features) ---
CULLIT_API_KEY=

# --- AI Provider Keys (set one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Ollama (local inference) ---
# OLLAMA_HOST=http://localhost:11434

# --- OpenClaw Gateway ---
# OPENCLAW_TOKEN=
# OPENCLAW_URL=http://localhost:18789

# --- Jira Integration ---
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=

# --- Linear Integration ---
# LINEAR_API_KEY=

# --- Publishing ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# GITHUB_TOKEN=   (auto-set in GitHub Actions)

# --- API Server (optional) ---
# CULLIT_API_TOKEN=           # Bearer token for API auth
# PORT=3000
# ALLOWED_ORIGINS=*           # Restrict in production
# RATE_LIMIT=30               # Requests per minute per IP
