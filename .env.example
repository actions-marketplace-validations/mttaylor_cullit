# =====================================================
# Cullit Environment Variables
# Copy this file to .env and fill in your values.
# =====================================================

# --- Cullit License (Pro features) ---
CULLIT_API_KEY=

# --- AI Provider Keys (set one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Ollama (local inference) ---
# OLLAMA_HOST=http://localhost:11434

# --- Jira Integration ---
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=

# --- Linear Integration ---
# LINEAR_API_KEY=

# --- Publishing ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# GITHUB_TOKEN=

# --- GitLab Integration ---
# GITLAB_TOKEN=
# GITLAB_PROJECT_ID=

# --- Bitbucket Integration ---
# BITBUCKET_USERNAME=
# BITBUCKET_APP_PASSWORD=

# --- Confluence Publishing ---
# CONFLUENCE_EMAIL=you@company.com
# CONFLUENCE_API_TOKEN=

# --- Notion Publishing ---
# NOTION_API_KEY=

# --- Hosted Changelog ---
# CULLIT_CHANGELOG_URL=https://api.cullit.io/changelog
# GITHUB_TOKEN=   (auto-set in GitHub Actions)

# --- API Server (optional) ---
# CULLIT_API_TOKEN=           # Bearer token for API auth
# PORT=3000

# --- Session Security ---
# CULLIT_JWT_SECRET — 256-bit random hex for signing JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CULLIT_JWT_SECRET=

# --- GitHub App (optional) ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=    # base64-encoded PEM or raw with \n
# GITHUB_WEBHOOK_SECRET=
# CULLIT_APP_PORT=3001
# ALLOWED_ORIGINS=*           # Restrict in production
# RATE_LIMIT=30               # Requests per minute per IP

# --- API Persistence (file-backed, defaults shown) ---
# CHANGELOG_STORE_PATH=./changelog-store.json
# HISTORY_STORE_PATH=./history-store.json
# DATABASE_URL=               # PostgreSQL connection string (enables DB mode)

# --- Observability ---
# METRICS_TOKEN=              # Bearer token to gate /metrics endpoint
