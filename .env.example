# =====================================================
# Cullit Environment Variables
# Copy this file to .env and fill in your values.
#
# Three deployment modes:
#   1. CLI only       — just set AI keys + any integrations you use
#   2. API server     — fill in the Server section too
#   3. Full dashboard — Server + Auth + Email
#
# Legend: [REQUIRED] must be set  |  [OPTIONAL] set if you use this feature
# =====================================================

# ===================
# CLI — AI Providers
# [REQUIRED for CLI] Set at least one provider key.
# ===================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# ===================
# CLI — Integrations [OPTIONAL] — set what you use
# ===================
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=

# LINEAR_API_KEY=

# GITLAB_TOKEN=
# GITLAB_PROJECT_ID=

# BITBUCKET_USERNAME=
# BITBUCKET_APP_PASSWORD=

# ===================
# CLI — Publishing [OPTIONAL] — set what you use
# ===================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# GITHUB_TOKEN=
# CONFLUENCE_EMAIL=you@company.com
# CONFLUENCE_API_TOKEN=
# NOTION_API_KEY=

# ===================
# API Server — Core
# [REQUIRED for API server]
# ===================
PORT=3000                                               # [REQUIRED]
CULLIT_BASE_URL=https://api.cullit.io                   # [REQUIRED]
CULLIT_DASHBOARD_URL=https://cullit.io/dashboard.html   # [REQUIRED]
ALLOWED_ORIGINS=https://cullit.io   # [REQUIRED] Comma-separated; use * for local dev only

# JWT signing secret — must be 32+ characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CULLIT_JWT_SECRET=                                      # [REQUIRED]

# Optional compatibility key (no longer required for feature access)
CULLIT_API_KEY=                                         # [OPTIONAL]

# ===================
# API Server — Database
# [REQUIRED for production] Without this, data is lost on restart.
# ===================
DATABASE_URL=   # [REQUIRED for production] PostgreSQL connection string
#
# Backup strategy:
#   Railway:     Automatic daily snapshots on Pro plan.
#                Manual: railway connect postgres → pg_dump > backup.sql
#   Self-hosted: 0 2 * * * pg_dump $DATABASE_URL | gzip > /backups/cullit-$(date +\%F).sql.gz

# ===================
# API Server — WorkOS AuthKit (dashboard login)
# [REQUIRED for dashboard] Configure at: https://dashboard.workos.com
#   Redirect URI: https://api.cullit.io/auth/callback
# ===================
WORKOS_CLIENT_ID=              # [REQUIRED for dashboard]
WORKOS_API_KEY=                # [REQUIRED for dashboard]

# ===================
# API Server — Sponsorship
# Cullit is fully open source. Optional support link for self-hosted UIs.
# ===================
# CULLIT_SPONSOR_URL=https://github.com/sponsors/mttaylor

# ===================
# API Server — Email (Resend)
# [OPTIONAL] Required for welcome and payment emails.
# ===================
# RESEND_API_KEY=
# EMAIL_FROM=Cullit <noreply@cullit.io>

# ===================
# API Server — GitHub App [OPTIONAL] — for Marketplace listing
# ===================
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=   # base64-encoded PEM
# GITHUB_WEBHOOK_SECRET=
# CULLIT_APP_PORT=3001

# ===================
# API Server — Observability [OPTIONAL]
# ===================
# METRICS_TOKEN=    # Bearer token to gate GET /metrics
# LOG_LEVEL=info    # trace | debug | info | warn | error | fatal

# ===================
# API Server — Tuning [OPTIONAL] — defaults shown
# ===================
# RATE_LIMIT=30         # Requests per minute per IP
# CACHE_TTL=300000      # Pipeline cache TTL in ms (5 min)
# MAX_CACHE_SIZE=100    # Max cached pipeline results
# CULLIT_LICENSE_URL=https://api.cullit.io/v1/license/validate  # Remote license validation for CLI/Action
# NODE_ENV=production   # Enables production safety checks
